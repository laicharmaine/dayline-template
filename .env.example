# Dayline settings. On Vercel: Project > Settings > Environment Variables (then redeploy).
# Locally: copy this file to .env and fill it in. Never commit .env.

# ---------- Required ----------
# The password you type to open Dayline (10+ characters).
APP_PASSWORD=
# Your Notion internal integration secret (notion.so/profile/integrations > your integration > Internal Integration Secret).
NOTION_TOKEN=

# ---------- Filled in by First-time setup ----------
# Leave these empty at first. Open your Dayline, sign in, and /setup creates the databases and shows these
# lines ready to paste. (Or run: npm run setup-notion -- "<link to your Notion page>")
NOTION_DATA_SOURCE_ID=
JOBS_DATA_SOURCE_ID=
BRAINSTORM_DATA_SOURCE_ID=
PEOPLE_DATA_SOURCE_ID=
TOUCHPOINTS_DATA_SOURCE_ID=
DAYLINE_STORE_DATA_SOURCE_ID=

# ---------- About you (optional) ----------
# Used to sign thank-you note drafts ("Best, Alex") and in AI prompts.
OWNER_NAME=
# One short phrase, e.g. "a business school student recruiting for product internships".
OWNER_ABOUT=
# Your time zone (IANA name). Default America/Chicago. Examples: America/New_York, America/Los_Angeles, Europe/London
APP_TIMEZONE=America/Chicago

# ---------- Calendars (optional, as many as you like) ----------
# Use each calendar's SECRET iCal / ICS link (see SETUP.md). Number them 1, 2, 3...
# GROUP is personal, school or social (guessed from the label if left out). KIND=canvas for Canvas feeds.
CAL_1_URL=
CAL_1_LABEL=Personal
CAL_1_GROUP=personal
# CAL_2_URL=
# CAL_2_LABEL=Classes
# CAL_2_GROUP=school
# CAL_3_URL=
# CAL_3_LABEL=Canvas
# CAL_3_GROUP=school
# CAL_3_KIND=canvas
# CAL_4_URL=
# CAL_4_LABEL=Partiful
# CAL_4_GROUP=social
# How long to cache calendars, in seconds (default 300).
# CAL_CACHE_SECONDS=300

# ---------- AI helpers (optional, free tier) ----------
# A Google AI Studio key turns on smarter job-link parsing, resume tips and thank-you drafts. Without it,
# Dayline uses simple built-in rules.
GEMINI_API_KEY=
# GEMINI_MODEL=

# ---------- Turn features off (optional) ----------
# JOBS_ENABLED=false
# BRAINSTORM_ENABLED=false
# NETWORK_ENABLED=false

# ---------- Advanced (optional) ----------
# Sign-in cookie key. If empty it is derived from APP_PASSWORD (changing the password signs everyone out).
# SESSION_SECRET=
# Allow a 6-9 character password.
# ALLOW_SHORT_PASSWORD=true
# Read Notion but never write to it (handy for trying things out).
# NOTION_READ_ONLY=true
# Notion user id to set as Assignee on new tasks (only if your To Do database has an Assignee column).
# NOTION_ASSIGNEE_ID=
# Local only: DATA_MODE=fixture shows fake demo data and never touches Notion.
# DATA_MODE=fixture
# PORT=4320
