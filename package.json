{
  "name": "dayline-template",
  "version": "0.1.0",
  "private": true,
  "description": "Dayline: your Notion to-dos, calendars, recruiting and classes on one calm screen.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "pretest": "node scripts/build-fixtures.js --today=2026-10-07 --reset --quiet",
    "test": "node --test test/",
    "fixtures": "node scripts/build-fixtures.js",
    "demo": "node scripts/build-fixtures.js --reset && DATA_MODE=fixture node server.js",
    "setup-notion": "node scripts/setup-notion.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.22.3",
    "node-ical": "0.26.1"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
